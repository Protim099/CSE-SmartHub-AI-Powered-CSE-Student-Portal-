# PostgreSQL (local: docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smarthub?schema=public"
# Session signing key, 32+ chars. Generate: openssl rand -base64 48
AUTH_SECRET=""
# Optional: live AI. Without it the assistant runs in clearly-labelled demo mode (retrieval only).
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# Where uploads are stored (use object storage such as Vercel Blob/S3 in production)
UPLOAD_DIR="./uploads"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
